# ─────────────────────────────────────────────────────────────────────────────
# CaféSmart — Environment Variable Template
# ─────────────────────────────────────────────────────────────────────────────
# Copy this file to `.env` and fill in the values, then run:
#   docker run --rm -p 3000:3000 -p 8000:8000 --env-file .env cafesmart:latest
#
# Or, for an automated bootstrap (generates AUTH_SECRET, prompts for secrets):
#   Linux/macOS : ./scripts/init-env.sh
#   Windows PS  : .\scripts\init-env.ps1
# ─────────────────────────────────────────────────────────────────────────────

# ── Database (REQUIRED) ────────────────────────────────────────────────────
# PostgreSQL connection string. Use postgresql:// NOT postgres://.
# Inside Docker, the host `localhost` is the container itself — use the
# container's hostname or an external IP/hostname that Docker can reach.
DATABASE_URL="postgresql://cafesmart:secret@db.example.com:5432/cafesmart"

# ── NextAuth / Auth.js v5 (REQUIRED for login) ────────────────────────────
# Generate with:  node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
AUTH_SECRET="REPLACE-ME-WITH-A-32-BYTE-RANDOM-BASE64-STRING"
AUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="REPLACE-ME-WITH-A-32-BYTE-RANDOM-BASE64-STRING"
NEXTAUTH_URL="http://localhost:3000"

# Google OAuth (REQUIRED for student/admin login flow)
AUTH_GOOGLE_ID="your-google-oauth-client-id.apps.googleusercontent.com"
AUTH_GOOGLE_SECRET="your-google-oauth-client-secret"

# ── PayHere payment gateway (REQUIRED for wallet top-up) ──────────────────
# Sandbox values for local dev; production values for real deploys.
PAYHERE_MERCHANT_ID="1211111"
PAYHERE_MERCHANT_SECRET="your-payhere-sandbox-merchant-secret"

# ── Application URLs ──────────────────────────────────────────────────────
# Public URL of the running app (used for OAuth callbacks, PayHere return URL, etc.)
NEXT_PUBLIC_BASE_URL="http://localhost:3000"

# ── Internal ML microservice ──────────────────────────────────────────────
# When running both Next.js and the ML service in ONE container (our default
# Dockerfile), the ML service listens on 127.0.0.1 inside the container.
# When running the ML service separately, set this to the ML service URL.
ML_SERVICE_URL="http://127.0.0.1:8000"

# ── Runtime ───────────────────────────────────────────────────────────────
# Optional. When true, Next.js telemetry is disabled.
NEXT_TELEMETRY_DISABLED="1"
# Optional. Defaults to 3000 in the Dockerfile.
PORT="3000"
# Optional. Defaults to 8000 in the Dockerfile (when ML service is co-hosted).
ML_SERVICE_PORT="8000"
