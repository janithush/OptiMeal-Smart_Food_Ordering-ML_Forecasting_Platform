# CaféSmart Test Environment

# Test environment: local | ci | staging
TEST_ENV=local

# Base URL for E2E tests
BASE_URL=http://localhost:3000

# API base URL (same as BASE_URL for Next.js Route Handlers)
API_URL=http://localhost:3000

# PostgreSQL for test database (use a separate test DB)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/cafesmart_test

# NextAuth test secret
NEXTAUTH_SECRET=test-secret-do-not-use-in-production

# NextAuth URL
NEXTAUTH_URL=http://localhost:3000

# ML service URL (optional — not needed for most tests)
ML_SERVICE_URL=http://localhost:8000
